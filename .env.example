# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in what you need. Never commit .env.local.
# Everything below is optional: with no keys at all the app still runs locally using
# FFmpeg only (audio-energy clip selection, no captions).
# ---------------------------------------------------------------------------

# --- Frontend ---------------------------------------------------------------
# Leave EMPTY to use the built-in Next.js API routes (recommended).
# Only set this if you run a separate processing API with the same contract, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=

# --- Storage ----------------------------------------------------------------
# Where uploads, transcripts and rendered clips are stored (relative to the project or absolute).
DATA_DIR=./data
# Reject uploads/imports larger than this many MB.
MAX_UPLOAD_MB=2048

# --- Binaries (REQUIRED on PATH, or give full paths) ------------------------
# FFmpeg + FFprobe are required. Windows example: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# yt-dlp is optional; needed only to import YouTube-style page links. Direct .mp4 links work without it.
YTDLP_PATH=yt-dlp

# --- AI (paid, optional) ----------------------------------------------------
# OpenAI key: used for Whisper transcription (captions) AND for AI clip selection.
# Any OpenAI-compatible service works via OPENAI_BASE_URL (Groq, OpenRouter, a local Ollama at http://localhost:11434/v1, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Chat model used to choose the clips from the transcript.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Must return word/segment timestamps (verbose_json). whisper-1 does.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Pipeline behaviour -----------------------------------------------------
# Transcription: auto (OpenAI if key set, else local Whisper if installed, else none) | openai | local | none
TRANSCRIPTION_PROVIDER=auto
# Clip choice: auto (AI if key + transcript, else heuristic) | openai (fail if unavailable) | heuristic (free)
CLIP_SELECTION_PROVIDER=auto
# Max number of clips produced per video (1-20).
MAX_CLIPS=5
# Videos processed at the same time.
JOB_CONCURRENCY=1

# --- Local Whisper (free, offline) ------------------------------------------
# Needs: python -m pip install faster-whisper "av<17"   (the model downloads on first use)
# Windows: "python" or "py". Linux/macOS: "python3". Can point to a venv python.
LOCAL_WHISPER_PYTHON=python
# tiny | base | small | medium | large-v3   (bigger = more accurate and slower)
LOCAL_WHISPER_MODEL=base
# cpu | cuda
LOCAL_WHISPER_DEVICE=cpu

# --- Security ---------------------------------------------------------------
# Imports from localhost/private-network URLs are blocked by default (SSRF protection).
# Set to true ONLY for local testing against your own server.
ALLOW_PRIVATE_URLS=false
